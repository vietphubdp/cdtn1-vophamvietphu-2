<mxCell id="b146" value="&lt;b&gt;INDEX (ngoài khóa chính) → phục vụ yêu cầu&lt;/b&gt;&lt;br&gt;• idx_ticket_center_due ON ticket(center_id, due_date) → FR10, FR11, NFR1&lt;br&gt;• customer.phone UNIQUE (tự tạo index) → FR1, NFR1 (tra cứu &amp;lt; 1 giây)&lt;br&gt;• idx_device_customer ON device(customer_id) → FR3&lt;br&gt;• idx_log_ticket ON ticket_status_log(ticket_id, changed_at) → FR6&lt;br&gt;• ticket.idempotency_key UNIQUE → NFR4 (không lập phiếu trùng)&lt;br&gt;• device.serial_no UNIQUE → QT-03" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=10;strokeWidth=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="470" height="165" as="geometry" /></mxCell>
<mxCell id="b147" value="&lt;b&gt;CHECK (quy tắc thi hành ở tầng dữ liệu)&lt;/b&gt;&lt;br&gt;• phone: 10 chữ số, bắt đầu bằng 0 (QT-02)&lt;br&gt;• priority ∈ {CAO, TRUNG_BINH, THAP}&lt;br&gt;• status ∈ 7 trạng thái của vòng đời (Hình 6.2), mặc định MOI&lt;br&gt;• warranty_status ∈ {CON_BAO_HANH, HET_BAO_HANH, CHUA_XAC_MINH}&lt;br&gt;• issue_desc 10–2000 ký tự · due_date &amp;gt; received_at&lt;br&gt;• ticket_code dạng BH000123/2026" style="whiteSpace=wrap;html=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=8;strokeWidth=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1080" y="850" width="380" height="140" as="geometry" /></mxCell>
<mxCell id="b148" value="" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="470" height="240" as="geometry" /></mxCell>
<mxCell id="b149" value="&lt;b&gt;CHÚ THÍCH (ký pháp chân chim)&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="696" width="300" height="20" as="geometry" /></mxCell>
<mxCell id="b151" value="Đúng một" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="160" y="723" width="200" height="18" as="geometry" /></mxCell>
<mxCell id="b153" value="Không hoặc một" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="160" y="749" width="200" height="18" as="geometry" /></mxCell>
<mxCell id="b155" value="Một hoặc nhiều" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="160" y="775" width="200" height="18" as="geometry" /></mxCell>
<mxCell id="b157" value="Không hoặc nhiều" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="160" y="801" width="200" height="18" as="geometry" /></mxCell>
<mxCell id="b158" value="PK = khóa chính · FK = khóa ngoại · tên bảng/cột dùng snake_case khớp bảng thuật ngữ SRS&lt;br&gt;Hộp vàng = 6 bảng của luồng L2 · hộp xám nét đứt = bảng dùng chung, chỉ dựng tối thiểu để tham chiếu&lt;br&gt;Đường xám = quan hệ tới bảng dùng chung · nhãn trên đường = động từ nghiệp vụ" style="text;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="840" width="450" height="125" as="geometry" /></mxCell>
<mxCell id="b159" value="&lt;b&gt;ERD – Luồng L2: Tiếp nhận và phân loại yêu cầu bảo hành (PostgreSQL, chuẩn 3NF)&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1440" height="30" as="geometry" /></mxCell>
