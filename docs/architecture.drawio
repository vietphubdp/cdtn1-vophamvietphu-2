<mxCell id="b51" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="62" width="300" height="22" as="geometry" /></mxCell>
