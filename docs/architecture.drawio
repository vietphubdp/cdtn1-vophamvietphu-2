<mxCell id="b49" value="Trách nhiệm: giữ dữ liệu, bảo đảm toàn vẹn bằng PK, FK, UNIQUE, NOT NULL, CHECK; INDEX phục vụ NFR1 (chi tiết ở ERD, Mục 4)." style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="962" width="1020" height="60" as="geometry" /></mxCell>
