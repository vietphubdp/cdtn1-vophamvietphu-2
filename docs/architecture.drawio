        <mxCell id="b61" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" value="Nét đứt = ngoài phạm vi L2" vertex="1">
