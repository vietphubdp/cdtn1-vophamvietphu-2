<mxCell id="b37" value="Trách nhiệm: đọc/ghi bằng SQL tham số hóa; phân trang ở cơ sở dữ liệu. KHÔNG chứa quy tắc nghiệp vụ." style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="782" width="1020" height="44" as="geometry" /></mxCell>
