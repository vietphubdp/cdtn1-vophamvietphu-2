<mxCell id="b60" value="" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="1122" y="272" width="60" height="30" as="geometry" /></mxCell>
<mxCell id="b61" value="Nét đứt = ngoài phạm vi L2" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1195" y="272" width="275" height="40" as="geometry" /></mxCell>
<mxCell id="b63" value="Mũi tên = phụ thuộc một chiều: lớp trên gọi lớp dưới; nhãn ghi cách trao đổi. Lớp dưới không gọi ngược lên." style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1195" y="313" width="275" height="60" as="geometry" /></mxCell>
<mxCell id="b64" value="QT-xx, NFRx, UCx, API n: mã quy tắc, yêu cầu phi chức năng, use case, endpoint trong SRS" style="text;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1122" y="367" width="345" height="40" as="geometry" /></mxCell>
<mxCell id="b65" value="&lt;b&gt;NGOÀI PHẠM VI (WON&amp;#x27;T – SRS Mục 1.3)&lt;/b&gt;&lt;br&gt;• Phân công kỹ thuật viên, lịch hẹn (L4)&lt;br&gt;• Đổi trạng thái sau MỚI, đóng phiếu (L4, L5)&lt;br&gt;• Kho linh kiện (L5) · Khảo sát hài lòng (L8)&lt;br&gt;• Tự động phân loại nhóm sự cố (L10)&lt;br&gt;• Dashboard toàn công ty (L6) · Gộp hồ sơ trùng (L1, L7)&lt;br&gt;• Gửi tin nhắn, in phiếu, đính kèm ảnh&lt;br&gt;• Quyết định phiếu chưa xác minh bảo hành (W12)&lt;br&gt;• Đăng ký và quản lý tài khoản người dùng (dùng tài khoản mẫu cấp sẵn)" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=10;strokeWidth=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="370" height="205" as="geometry" /></mxCell>
<mxCell id="b66" value="&lt;b&gt;VÍ DỤ ĐƯỜNG ĐI: Lập phiếu (UC5)&lt;/b&gt;&lt;br&gt;1. M1 gửi POST /api/tickets (kèm Idempotency-Key)&lt;br&gt;2. AuthMiddleware lấy vai trò, trung tâm&lt;br&gt;3. TicketController kiểm tra định dạng → lỗi 9a trả 400&lt;br&gt;4. TicketService kiểm QT-03 (lỗi 9b → 422), sinh mã, hạn cam kết (QT-04), trạng thái MỚI&lt;br&gt;5. TicketRepository + TicketStatusLogRepository ghi trong MỘT giao dịch (NFR4)&lt;br&gt;6. INSERT ticket, ticket_status_log&lt;br&gt;7. Trả 201 + mã phiếu, hạn cam kết → M1 hiển thị" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=10;strokeWidth=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="370" height="240" as="geometry" /></mxCell>
<mxCell id="e3" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.6;endArrow=block;startArrow=none;endFill=1;startFill=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="105" as="sourcePoint" /><mxPoint x="560" y="150" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="e17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.6;endArrow=block;startArrow=none;endFill=1;startFill=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="382" as="sourcePoint" /><mxPoint x="560" y="430" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="e27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.6;endArrow=block;startArrow=none;endFill=1;startFill=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="652" as="sourcePoint" /><mxPoint x="560" y="700" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="e38" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.6;endArrow=block;startArrow=none;endFill=1;startFill=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="830" as="sourcePoint" /><mxPoint x="560" y="875" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="e62" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.6;endArrow=block;startArrow=none;endFill=1;startFill=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1152" y="317" as="sourcePoint" /><mxPoint x="1152" y="351" as="targetPoint" /></mxGeometry></mxCell>
