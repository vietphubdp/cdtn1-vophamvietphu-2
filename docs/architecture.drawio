<mxCell id="b1" value="&lt;b&gt;SƠ ĐỒ KIẾN TRÚC PHÂN LỚP – Luồng L2: Tiếp nhận và phân loại yêu cầu bảo hành (track SE)&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1440" height="30" as="geometry" /></mxCell>
<mxCell id="b2" value="&lt;b&gt;NGƯỜI DÙNG qua trình duyệt web&lt;/b&gt;&lt;br&gt;Nhân viên tiếp nhận · Quản lý trung tâm" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1040" height="50" as="geometry" /></mxCell>
<mxCell id="b4" value="HTTP + JSON (REST) · header Authorization: Bearer &amp;lt;token&amp;gt; · hợp đồng API: Phụ lục C SRS" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="575" y="109" width="500" height="40" as="geometry" /></mxCell>
<mxCell id="b5" value="" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1040" height="232" as="geometry" /></mxCell>
<mxCell id="b6" value="&lt;b&gt;1 · LỚP TRÌNH BÀY (Presentation) — tổ chức theo MVC: View + Controller&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="155" width="900" height="22" as="geometry" /></mxCell>
<mxCell id="b7" value="&lt;b&gt;View M1 · Lập phiếu bảo hành&lt;/b&gt;&lt;br&gt;UC5 (gồm UC1, UC4)" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="55" y="185" width="220" height="62" as="geometry" /></mxCell>
<mxCell id="b8" value="&lt;b&gt;View M2 · Tạo khách hàng mới / Ghi nhận thiết bị mới&lt;/b&gt;&lt;br&gt;UC2, UC3" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="185" width="220" height="62" as="geometry" /></mxCell>
<mxCell id="b9" value="&lt;b&gt;View M3 · Danh sách phiếu&lt;/b&gt;&lt;br&gt;UC6" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="525" y="185" width="220" height="62" as="geometry" /></mxCell>
<mxCell id="b10" value="&lt;b&gt;CustomerController&lt;/b&gt;&lt;br&gt;API 1, 3" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="55" y="258" width="165" height="50" as="geometry" /></mxCell>
<mxCell id="b11" value="&lt;b&gt;DeviceController&lt;/b&gt;&lt;br&gt;API 2, 4, 5" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="258" width="165" height="50" as="geometry" /></mxCell>
<mxCell id="b12" value="&lt;b&gt;TicketController&lt;/b&gt;&lt;br&gt;API 7, 8" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="405" y="258" width="165" height="50" as="geometry" /></mxCell>
<mxCell id="b13" value="&lt;b&gt;CategoryController&lt;/b&gt;&lt;br&gt;API 6" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="258" width="165" height="50" as="geometry" /></mxCell>
<mxCell id="b14" value="&lt;b&gt;AuthMiddleware&lt;/b&gt;&lt;br&gt;xác thực token; lấy vai trò và trung tâm của người gọi (QT-14)" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="185" width="305" height="62" as="geometry" /></mxCell>
<mxCell id="b15" value="&lt;b&gt;ResponseMapper&lt;/b&gt;&lt;br&gt;che số điện thoại theo vai trò (NFR2, QT-15); đổi lỗi nghiệp vụ thành mã HTTP 400/404/409/422" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="258" width="305" height="62" as="geometry" /></mxCell>
<mxCell id="b16" value="Trách nhiệm: nhận yêu cầu, kiểm tra định dạng đầu vào (bắt buộc, kiểu, độ dài), gọi service, trả JSON. KHÔNG chứa quy tắc nghiệp vụ, KHÔNG truy vấn cơ sở dữ liệu." style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="326" width="1020" height="52" as="geometry" /></mxCell>
<mxCell id="b18" value="Gọi hàm service, truyền DTO + người gọi (vai trò, trung tâm) · nhận kết quả hoặc lỗi nghiệp vụ" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="575" y="386" width="500" height="40" as="geometry" /></mxCell>
<mxCell id="b19" value="" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1040" height="222" as="geometry" /></mxCell>
<mxCell id="b20" value="&lt;b&gt;2 · LỚP NGHIỆP VỤ (Service) — TOÀN BỘ quy tắc nghiệp vụ nằm ở lớp này&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="435" width="1000" height="22" as="geometry" /></mxCell>
<mxCell id="b21" value="&lt;b&gt;CustomerService&lt;/b&gt;&lt;br&gt;tra cứu khách, chuẩn hóa số điện thoại, tạo khách&lt;br&gt;QT-01, QT-02 · UC1, UC2" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=top;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="55" y="465" width="195" height="112" as="geometry" /></mxCell>
<mxCell id="b22" value="&lt;b&gt;DeviceService&lt;/b&gt;&lt;br&gt;ghi nhận thiết bị, kiểm tra serial/IMEI&lt;br&gt;QT-03 · UC3" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=top;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="260" y="465" width="195" height="112" as="geometry" /></mxCell>
<mxCell id="b23" value="&lt;b&gt;WarrantyService&lt;/b&gt;&lt;br&gt;xác định tình trạng bảo hành&lt;br&gt;QT-05 · UC4" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=top;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="465" y="465" width="195" height="112" as="geometry" /></mxCell>
<mxCell id="b24" value="&lt;b&gt;TicketService&lt;/b&gt;&lt;br&gt;lập phiếu: sinh mã phiếu, hạn cam kết (DueDateCalculator), trạng thái MỚI, lịch sử; một giao dịch; chống lưu trùng&lt;br&gt;QT-03, QT-04, QT-06 · NFR4 · UC5" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=top;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="670" y="465" width="195" height="112" as="geometry" /></mxCell>
<mxCell id="b25" value="&lt;b&gt;TicketQueryService&lt;/b&gt;&lt;br&gt;danh sách phiếu theo trung tâm, sắp theo hạn cam kết, đánh dấu quá hạn&lt;br&gt;QT-14 · UC6" style="whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=top;spacing=6;strokeWidth=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="875" y="465" width="195" height="112" as="geometry" /></mxCell>
<mxCell id="b26" value="Trách nhiệm: thi hành QT-01 … QT-06 và QT-14; mở và đóng giao dịch. Chỉ biết giao diện Repository, KHÔNG biết SQL hay PostgreSQL. DueDateCalculator là hàm thuần (không đọc/ghi dữ liệu) để kiểm thử đơn vị." style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="585" width="1020" height="60" as="geometry" /></mxCell>
<mxCell id="b28" value="Gọi qua giao diện Repository (findByPhone, save, …) · nhận đối tượng miền" style="text;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#333333;align=left;verticalAlign=top;spacing=2;strokeWidth=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="575" y="656" width="500" height="40" as="geometry" /></mxCell>
