# Sao chép thành .env rồi điền giá trị thật: cp .env.example .env
# Không commit file .env.

# Cổng chạy máy chủ web
PORT=3000

# Kết nối PostgreSQL 16+. npm run db:migrate tự tạo CSDL DB_NAME nếu chưa có,
# nên DB_USER cần quyền CREATEDB (tài khoản postgres mặc định có quyền này).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_crm_l2

# Khóa ký JWT: chuỗi ngẫu nhiên dài, ví dụ tạo bằng
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai
# Thời hạn JWT (cú pháp của jsonwebtoken: 8h, 30m, 1d…)
JWT_EXPIRES_IN=8h
