<!doctype html>
<html lang="vi">
<head>
    <%- include('partials/head') %>
    <title>Tạo khách hàng · Smart CRM Mekong Mobile</title>
    <script src="/public/js/format.js" defer></script>
    <script src="/public/js/customer-create.js" defer></script>
</head>
<body class="min-h-dvh bg-neutral-50 font-sans text-neutral-900 antialiased">
<%# M2 · Tạo khách hàng mới / Ghi nhận thiết bị mới — UC2, UC3 · US2, US3. Theo docs/wireframe.png.
    Mở từ M1: 3a (?phone=) tạo khách rồi ghi nhận thiết bị; 4a (?phone=&customer_id=) chỉ ghi nhận thiết bị.
    Trang chỉ có khung; dữ liệu lấy và gửi qua API 1, 3, 4, 11 bằng public/js/customer-create.js. %>
<%- include('partials/navbar') %>
<div class="lg:flex">
    <%- include('partials/sidebar') %>
    <div class="flex min-h-[calc(100dvh-4rem)] min-w-0 flex-1 flex-col">
        <main class="mx-auto w-full max-w-4xl flex-1 space-y-6 px-4 py-6 sm:px-6 lg:px-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <h1 class="text-2xl font-semibold tracking-tight">Tạo khách hàng mới / Ghi nhận thiết bị mới</h1>
                    <p class="card-desc mt-1">Mở từ màn hình lập phiếu. Lưu xong quay lại lập phiếu với dữ liệu vừa tạo.</p>
                </div>
                <a class="btn-outline shrink-0" id="back-link" href="/tickets/new">Quay lại lập phiếu</a>
            </div>

            <%# ---------- Tạo khách hàng mới (UC2, API 3) ---------- %>
            <section class="card" aria-labelledby="customer-title">
                <h2 class="card-title" id="customer-title">Tạo khách hàng mới</h2>

                <form class="mt-4 space-y-5" id="customer-form" novalidate>
                    <div class="grid gap-5 md:grid-cols-2">
                        <div>
                            <label class="label" for="full_name">Họ tên *</label>
                            <input class="input" id="full_name" name="full_name" type="text" maxlength="120" autocomplete="off"
                                   aria-describedby="full_name-error">
                            <p class="field-error" id="full_name-error" data-error-for="full_name"></p>
                        </div>
                        <div>
                            <label class="label" for="phone">Số điện thoại *</label>
                            <input class="input" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="off"
                                   placeholder="0901 234 567" aria-describedby="phone-hint phone-error">
                            <p class="hint" id="phone-hint">Điền sẵn từ màn hình lập phiếu</p>
                            <p class="field-error" id="phone-error" data-error-for="phone"></p>
                        </div>
                        <div>
                            <label class="label" for="email">Email</label>
                            <input class="input" id="email" name="email" type="email" maxlength="120" autocomplete="off"
                                   aria-describedby="email-error">
                            <p class="field-error" id="email-error" data-error-for="email"></p>
                        </div>
                        <div>
                            <label class="label" for="address">Địa chỉ</label>
                            <input class="input" id="address" name="address" type="text" maxlength="255" autocomplete="off"
                                   aria-describedby="address-error">
                            <p class="field-error" id="address-error" data-error-for="address"></p>
                        </div>
                    </div>

                    <div class="space-y-3" aria-live="polite">
                        <%# QT-01: số đã có (409) → mở hồ sơ có sẵn, dùng error.details.customer_id %>
                        <p class="alert-error" id="customer-conflict" hidden>
                            ⚠ Số điện thoại đã tồn tại.
                            <a class="link" id="customer-existing-link" href="/tickets/new">Mở hồ sơ có sẵn →</a>
                        </p>
                        <p class="alert-error" id="customer-save-error" hidden></p>
                        <div class="alert-error flex flex-wrap items-center justify-between gap-3" id="customer-retry-box" hidden>
                            <span data-message></span>
                            <button type="button" class="btn-outline" id="customer-retry">Thử lưu lại</button>
                        </div>
                    </div>

                    <div class="flex sm:justify-end">
                        <button type="submit" class="btn-primary w-full sm:w-auto" id="customer-save">Lưu khách hàng</button>
                    </div>
                </form>

                <%# 4a, hoặc sau khi lưu khách: hiện khách đã có (số đã che theo vai trò – QT-15) %>
                <div class="mt-4 space-y-3" aria-live="polite">
                    <p class="skeleton px-4 py-3 text-sm text-neutral-500" id="customer-loading" hidden>Đang tải khách hàng…</p>
                    <div class="alert-error flex flex-wrap items-center justify-between gap-3" id="customer-error" hidden>
                        <span data-message></span>
                        <button type="button" class="btn-outline" id="customer-load-retry">Thử lại</button>
                    </div>
                    <p class="alert-success" id="customer-success" tabindex="-1" hidden></p>
                    <dl class="tile grid gap-x-6 gap-y-2 text-sm md:grid-cols-2" id="customer-info" hidden>
                        <div><dt class="inline text-neutral-500">Họ tên:</dt> <dd class="inline font-medium" data-field="full_name"></dd></div>
                        <div><dt class="inline text-neutral-500">Số điện thoại:</dt> <dd class="inline font-medium" data-field="phone"></dd></div>
                    </dl>
                </div>
            </section>

            <%# ---------- Ghi nhận thiết bị mới (UC3, API 4, API 11) ---------- %>
            <section class="card" aria-labelledby="device-title">
                <h2 class="card-title" id="device-title">Ghi nhận thiết bị mới</h2>
                <p class="card-desc mt-1" id="device-locked">Lưu khách hàng trước khi ghi nhận thiết bị.</p>

                <form class="mt-4 space-y-5" id="device-form" novalidate>
                    <fieldset class="grid gap-5 disabled:opacity-60 md:grid-cols-2" id="device-fields" disabled>
                        <legend class="sr-only">Thông tin thiết bị</legend>
                        <div>
                            <label class="label" for="product_id">Tên máy *</label>
                            <select class="select" id="product_id" name="product_id" aria-describedby="product_id-hint product_id-error">
                                <option value="">Đang tải…</option>
                            </select>
                            <p class="hint" id="product_id-hint">Chọn từ danh mục sản phẩm đang sử dụng</p>
                            <p class="field-error" id="product_id-error" data-error-for="product_id"></p>
                        </div>
                        <div>
                            <label class="label" for="serial_no">Serial/IMEI *</label>
                            <input class="input" id="serial_no" name="serial_no" type="text" maxlength="50" autocomplete="off"
                                   aria-describedby="serial_no-error">
                            <p class="field-error" id="serial_no-error" data-error-for="serial_no"></p>
                        </div>
                        <div>
                            <label class="label" for="purchase_date">Ngày mua</label>
                            <input class="input" id="purchase_date" name="purchase_date" type="text" inputmode="numeric" autocomplete="off"
                                   placeholder="dd/mm/yyyy" aria-describedby="purchase_date-hint purchase_date-error">
                            <p class="hint" id="purchase_date-hint">Để trống nếu khách không nhớ</p>
                            <p class="field-error" id="purchase_date-error" data-error-for="purchase_date"></p>
                        </div>
                        <div>
                            <label class="label" for="warranty_months">Số tháng bảo hành</label>
                            <input class="input" id="warranty_months" name="warranty_months" type="text" inputmode="numeric" autocomplete="off"
                                   aria-describedby="warranty_months-hint warranty_months-error">
                            <p class="hint" id="warranty_months-hint">Điền sẵn theo sản phẩm đã chọn, sửa được 1–60</p>
                            <p class="field-error" id="warranty_months-error" data-error-for="warranty_months"></p>
                        </div>
                    </fieldset>

                    <%# Danh mục sản phẩm (API 11): đặt ngoài fieldset để nút "Thử lại" bấm được cả khi chưa có khách %>
                    <div class="space-y-3" aria-live="polite">
                        <p class="tile text-center text-sm text-neutral-500" id="product-empty" hidden>Chưa có sản phẩm nào đang sử dụng</p>
                        <div class="alert-error flex flex-wrap items-center justify-between gap-3" id="product-error" hidden>
                            <span>Không tải được danh mục sản phẩm</span>
                            <button type="button" class="btn-outline" id="product-retry">Thử lại</button>
                        </div>
                    </div>

                    <div class="space-y-3" aria-live="polite">
                        <%# QT-03: serial đã ghi nhận (409); ngày mua ở tương lai (400) báo ở trường (7) %>
                        <p class="alert-error" id="device-save-error" hidden></p>
                        <div class="alert-error flex flex-wrap items-center justify-between gap-3" id="device-retry-box" hidden>
                            <span data-message></span>
                            <button type="button" class="btn-outline" id="device-retry">Thử lưu lại</button>
                        </div>
                    </div>

                    <div class="flex sm:justify-end">
                        <button type="submit" class="btn-primary w-full sm:w-auto" id="device-save" disabled>Lưu thiết bị</button>
                    </div>
                </form>
            </section>
        </main>
        <%- include('partials/footer') %>
    </div>
</div>
</body>
</html>
